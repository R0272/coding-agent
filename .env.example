# ============================================================
# Mini Coding Agent 配置示例
# ============================================================
#
# 使用方法：
# 1. 复制本文件并改名为 .env
# 2. 将 OPENROUTER_API_KEY 替换为自己的真实 Key
#
# 注意：
# .env 中包含真实 API Key，未提交到 Git 仓库。


# ------------------------------------------------------------
# OpenRouter API
# ------------------------------------------------------------

OPENROUTER_API_KEY=your_openrouter_api_key_here

# 直接调用 OpenRouter 的 OpenAI-compatible REST API。
AGENT_API_BASE=https://openrouter.ai/api/v1

# 默认免费模型。
# 当前模型支持 tool calling，适合 coding agent。
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 单次 HTTP 请求最大等待时间（秒）。
AGENT_API_TIMEOUT=180


# ------------------------------------------------------------
# Agent 主循环
# ------------------------------------------------------------

# 最大模型调用轮数，防止 Agent 陷入无限循环。
AGENT_MAX_ITERATIONS=40

# 单轮模型最大输出 token 数。
AGENT_MAX_TOKENS=8192


# ------------------------------------------------------------
# 本地工具
# ------------------------------------------------------------

# run_bash 默认超时时间（秒）。
AGENT_BASH_TIMEOUT=30

# 普通工具结果最大字符数。
AGENT_MAX_TOOL_OUTPUT_CHARS=20000

# read_file 单次读取最大字符数。
AGENT_MAX_FILE_READ_CHARS=30000


# ------------------------------------------------------------
# 上下文管理
# ------------------------------------------------------------

# 达到该估算 token 数后压缩旧工具输出。
AGENT_MAX_CONTEXT_TOKENS=120000

# 压缩时保留最近多少轮完整历史。
AGENT_KEEP_RECENT_TURNS=6

# 粗略估算 token 时使用：
# token ≈ 字符数 / 此值
AGENT_APPROX_CHARS_PER_TOKEN=4.0


# ------------------------------------------------------------
# API 错误重试
# ------------------------------------------------------------

# 临时网络错误 / 429 / 5xx 最大重试次数。
AGENT_MAX_RETRIES=5

# 指数退避初始等待秒数。
AGENT_RETRY_BASE_DELAY=1.0
